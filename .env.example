# BytePlus ModelArk Singapore. Never commit a real API key.
BYTEPLUS_API_KEY=
# True only after quota, activation and Free Credits Only coverage are verified.
BYTEPLUS_FREE_QUOTA_CONFIRMED=false

# SiliconFlow international (.com). Fill the key locally; never commit .env.
VIDEO_PROVIDER=byteplus
SILICONFLOW_API_KEY=
# Only after checking that credit/coupons in Account Overview cover video.
# Used only if the old balance API is unavailable; not an API verification.
SILICONFLOW_CREDIT_CONFIRMED=false

# Optional legacy provider: Alibaba Singapore / International.
DASHSCOPE_API_KEY=
# Set true ONLY after confirming remaining, unexpired quotas AND enabling
# Free Quota Only for BOTH wan2.7-t2v and qwen-flash in Model Studio Singapore.
# This flag records your confirmation; it cannot verify the console switches.
ALIBABA_FREE_QUOTA_CONFIRMED=false

# Optional: select VIDEO_PROVIDER=pollinations to use the previous paid provider.
POLLINATIONS_API_KEY=
PORT=8787
